FROM alpine:3.19

# نصب ابزارهای حرفه‌ای
RUN apk add --no-cache curl bash supervisor libc6-compat

WORKDIR /app

# نصب پنل s-ui
RUN curl -L https://github.com/mhsanaei/3x-ui/releases/download/v3.4.2/x-ui-linux-amd64.tar.gz -o x-ui.tar.gz \
    && tar -xzf x-ui.tar.gz --strip-components=1 && rm x-ui.tar.gz && chmod +x x-ui

# تنظیم Supervisord (برای اجرای همزمان دو پنل یا دو سرویس)
RUN mkdir -p /etc/supervisor/conf.d
COPY <<EOF /etc/supervisor/conf.d/supervisord.conf
[supervisord]
nodaemon=true
user=root

[program:x-ui]
command=/app/x-ui
directory=/app
autostart=true
autorestart=true

[program:helper]
command=python3 -m http.server 8080
directory=/app
autostart=true
autorestart=true
EOF

# تنظیمات اولیه پنل
RUN ./x-ui setting -username admin -password admin -port 3000 -webBasePath /panel/

EXPOSE 3000 8080
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
