FROM node:18-alpine

# نصب پیش‌نیازها برای اجرای پنل
RUN apk add --no-cache git bash

# کلون کردن مخزن s-ui از گیت‌هاب
RUN git clone https://github.com/alireza0/s-ui.git /app
WORKDIR /app

# نصب وابستگی‌ها
RUN npm install
RUN npm run build

# اجرای پنل روی پورت 2053
ENV PORT=2053
EXPOSE 2053

CMD ["npm", "start"]
