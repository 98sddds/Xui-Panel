FROM debian:bookworm-slim

# نصب تور و ابزارهای مورد نیاز
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget tor ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# دانلود و نصب پنل 3x-ui
RUN wget -O /tmp/x-ui.tar.gz https://github.com/mhsanaei/3x-ui/releases/latest/download/x-ui-linux-amd64.tar.gz \
    && tar -zxvf /tmp/x-ui.tar.gz -C /usr/local/ \
    && mv /usr/local/x-ui-linux-amd64 /usr/local/x-ui && rm /tmp/x-ui.tar.gz

# ایجاد پوشه‌های تور و تنظیمات آن مستقیماً در کانتینر
RUN mkdir -p /var/lib/tor/xui_service && \
    echo "SocksPort 9050" > /etc/tor/torrc && \
    echo "HiddenServiceDir /var/lib/tor/xui_service/" >> /etc/tor/torrc && \
    echo "HiddenServicePort 80 127.0.0.1:2053" >> /etc/tor/torrc

# استفاده از یک خط دستور برای اجرای همزمان تور و پنل
# این دستور جایگزین فایل start.sh می‌شود
CMD tor & cd /usr/local/x-ui && ./x-ui
